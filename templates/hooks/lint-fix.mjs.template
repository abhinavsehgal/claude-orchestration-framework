#!/usr/bin/env node
// Pattern 4 — PostToolUse lint-fix hook.
//
// Wired in `.claude/settings.json` as:
//   "PostToolUse": [{
//     "matcher": "Write|Edit|MultiEdit",
//     "hooks": [{ "type": "command", "command": "node .claude/scripts/lint-fix.mjs" }]
//   }]
//
// After every Write|Edit|MultiEdit, runs the project's auto-fix linter on
// the file just touched. Always exits 0 — lint problems must NEVER block an
// edit. Build correctness is enforced separately by the build-gate Stop hook.
//
// === Customization (REQUIRED) ===
// Edit the constants below to match your stack:
//   - LINTABLE_RE: regex for files that should be linted
//   - LINT_COMMAND_BUILDER: function that returns the [cmd, ...args] to run
//                           given a file path
//   - DEPS_SENTINEL: path that proves the linter is installed
//   - SKIP_PREFIXES: dependency / build-output / VCS directories never worth linting
//   - TIMEOUT_MS: per-file timeout
//
// Examples:
//   Next.js (next lint --file):
//     LINT_COMMAND_BUILDER = (rel) => ["npx", "--no-install", "next", "lint", "--fix", "--file", rel, "--no-error-on-unmatched-pattern"]
//     DEPS_SENTINEL = "node_modules/next"
//
//   ESLint:
//     LINT_COMMAND_BUILDER = (rel) => ["npx", "--no-install", "eslint", "--fix", "--cache", "--cache-location", ".eslintcache", "--no-error-on-unmatched-pattern", rel]
//     DEPS_SENTINEL = "node_modules/eslint"
//
//   Ruff (Python):
//     LINT_COMMAND_BUILDER = (rel) => ["ruff", "check", "--fix", "--quiet", rel]
//     DEPS_SENTINEL = ".venv/bin/ruff"  (or wherever ruff is installed)
//
//   gofmt:
//     LINT_COMMAND_BUILDER = (rel) => ["gofmt", "-w", rel]
//     DEPS_SENTINEL = null  // gofmt ships with go
//
//   rustfmt:
//     LINT_COMMAND_BUILDER = (rel) => ["rustfmt", rel]
//     DEPS_SENTINEL = null

import { existsSync, readFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = resolve(SCRIPT_DIR, "..", "..");

// EDIT THESE for your stack:
const LINTABLE_RE = /\.(ts|tsx|js|jsx|mjs|cjs)$/;
const LINT_COMMAND_BUILDER = (rel) => [
  "npx", "--no-install", "next", "lint",
  "--fix", "--file", rel,
  "--no-error-on-unmatched-pattern",
];
const DEPS_SENTINEL = "node_modules/next";  // null to skip the check
const SKIP_PREFIXES = ["node_modules/", ".next/", ".git/"];  // e.g. ["venv/", "target/", "dist/", ".git/"]
const TIMEOUT_MS = 20_000;

function readStdin() {
  try { return readFileSync(0, "utf-8"); } catch { return ""; }
}

function extractFilePath(s) {
  if (!s) return null;
  try {
    const data = JSON.parse(s);
    const ti = data.tool_input ?? data.toolInput ?? data.input ?? {};
    return ti.file_path ?? ti.filePath ?? ti.path ?? null;
  } catch { return null; }
}

function main() {
  const filePath = extractFilePath(readStdin());
  if (!filePath) process.exit(0);

  let rel;
  try {
    const abs = resolve(REPO_ROOT, filePath);
    rel = relative(REPO_ROOT, abs);
  } catch { process.exit(0); }
  if (!rel || rel.startsWith("..")) process.exit(0);
  if (SKIP_PREFIXES.some((p) => rel.startsWith(p))) process.exit(0);
  if (!LINTABLE_RE.test(rel)) process.exit(0);

  if (DEPS_SENTINEL && !existsSync(join(REPO_ROOT, DEPS_SENTINEL))) process.exit(0);

  const cmd = LINT_COMMAND_BUILDER(rel);
  spawnSync(cmd[0], cmd.slice(1), {
    cwd: REPO_ROOT,
    encoding: "utf-8",
    stdio: ["ignore", "ignore", "ignore"],
    timeout: TIMEOUT_MS,
  });
  // ALWAYS exit 0 — lint must never block an edit.
  process.exit(0);
}

try { main(); } catch { process.exit(0); }
